{
  "manifest_version": 3,
  "name": "JobTracker Companion",
  "version": "1.1.0",
  "description": "Capture job postings from any page and save them to your JobTracker account.",
  "action": {
    "default_title": "Save this job to JobTracker",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://jobapptracker.tryasp.net/*"]
}
