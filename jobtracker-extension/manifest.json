{
  "manifest_version": 3,
  "name": "JobTracker Companion",
  "version": "1.0.0",
  "description": "Capture job postings, keep an offline shortlist, and sync them with JobTracker.",
  "action": {
    "default_title": "Open JobTracker Companion"
  },
  "side_panel": { "default_path": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage", "tabs", "scripting", "cookies", "sidePanel"],
  "host_permissions": ["<all_urls>"]
}
